<Window
    x:Class="LiquidConvert.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LiquidConvert">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧侧边栏 -->
        <Border Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部 Logo 区 -->
                <StackPanel Margin="24,24,24,8" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="Assets/StoreLogo.png" Width="32" Height="32" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LiquidConvert" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="本地媒体工作台" FontSize="11" Opacity="0.58" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 导航菜单按钮区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="2" Padding="12,0,12,18">
                        <Button x:Name="NavHome" Tag="home" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="主页" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="12,8" />
                        <TextBlock Text="媒体与图像" Margin="16,4,0,6" FontSize="11" FontWeight="SemiBold" Opacity="0.45" />

                        <Button x:Name="NavConvert" Tag="convert" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="图片转换" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavCompress" Tag="compress" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="图片压缩" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavStitch" Tag="stitch" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="图片拼接" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavVideo" Tag="video" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="视频 GIF" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAudio" Tag="audio" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="音频转换" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavIcon" Tag="icon" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="图标转换" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavShutter" Tag="shutter" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="快门检测" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="12,8" />
                        <TextBlock Text="AI 与文档" Margin="16,4,0,6" FontSize="11" FontWeight="SemiBold" Opacity="0.45" />

                        <Button x:Name="NavDocument" Tag="document" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="AI 文档提取" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavLark" Tag="lark" Click="ModeButton_Click" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                <TextBlock Text="Lark2Pad" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部用户与设置区 -->
                <Border Grid.Row="2" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Background="{ThemeResource AvatarBackgroundBrush}" CornerRadius="16">
                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="UserNameText" Text="UserName" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="本地工作区" FontSize="10" Opacity="0.55" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="SettingsNavButton" Tag="settings" Click="ModeButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,6" CornerRadius="6" ToolTipService.ToolTip="设置">
                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧 Frame 视图加载容器 -->
        <Grid Grid.Column="1" Padding="32,24">
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </Grid>
    </Grid>
</Window>
