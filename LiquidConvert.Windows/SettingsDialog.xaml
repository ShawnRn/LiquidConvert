<ContentDialog
    x:Class="LiquidConvert.Windows.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    PrimaryButtonText="完成"
    DefaultButton="Primary">
    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="22" MinWidth="420">
            <StackPanel Spacing="8">
                <TextBlock Text="外观" FontWeight="SemiBold" />
                <RadioButtons x:Name="ThemePicker" SelectionChanged="ThemePicker_SelectionChanged">
                    <x:String>跟随系统</x:String>
                    <x:String>浅色</x:String>
                    <x:String>深色</x:String>
                </RadioButtons>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="默认输出位置" FontWeight="SemiBold" />
                <TextBlock x:Name="OutputFolderText" TextWrapping="Wrap" Opacity="0.65" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="选择文件夹" Click="ChooseOutputFolder_Click" />
                    <Button Content="每次询问" Click="ClearOutputFolder_Click" />
                </StackPanel>
                <TextBlock Text="设置后，转换结果会直接保存到该文件夹；选择“每次询问”可恢复操作时选择路径。" FontSize="12" TextWrapping="Wrap" Opacity="0.55" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="Lark2Pad" FontWeight="SemiBold" />
                <TextBlock x:Name="LarkSessionText" Opacity="0.65" />
                <Button x:Name="ClearLarkSessionButton" Content="清除 Etherpad 登录会话" HorizontalAlignment="Left" Click="ClearLarkSession_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
