<Page
    x:Class="LiquidConvert.Windows.Views.VideoGifPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 Header -->
        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="视频转 GIF 动图" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="轻松将视频指定片段截取并转换为高质量 GIF 动态图片。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="选择视频文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- 中部左右分栏 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧设置面板 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="GIF 动图生成配置" FontSize="16" FontWeight="SemiBold" />

                        <!-- 帧率 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="帧率 (FPS)" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="FpsCombo" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="10 FPS (轻量流畅)" />
                                <ComboBoxItem Content="15 FPS (推荐默认)" />
                                <ComboBoxItem Content="24 FPS (电影级流畅)" />
                                <ComboBoxItem Content="30 FPS (超流畅)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 分辨率 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="分辨率宽度" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="WidthCombo" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="480 px (小体积)" />
                                <ComboBoxItem Content="720 px (标清 720p)" />
                                <ComboBoxItem Content="1080 px (高清 1080p)" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Opacity="0.5" />

                        <!-- 截取区间 -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="视频片段截取区间 (秒)" FontSize="13" Opacity="0.7" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="StartSecBox" Header="开始时间 (s)" Value="0" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                <NumberBox Grid.Column="1" x:Name="EndSecBox" Header="结束时间 (s)" Value="0" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="建议截取 1-10 秒范围，体积更轻便。" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧视频卡片与拖拽区 -->
            <Border Grid.Column="1" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid>
                    <!-- 未选择文件 -->
                    <StackPanel x:Name="EmptyZone" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="32" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽视频文件到这里" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="支持 MP4, MOV, MKV, AVI, WebM 等常见的视频格式。" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="选择视频文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 已选择文件 -->
                    <StackPanel x:Name="FileCard" Visibility="Collapsed" VerticalAlignment="Center" Spacing="20" MaxWidth="500" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="12" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" Background="#100F6CBD" CornerRadius="10">
                                    <FontIcon Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="FileNameText" Text="movie.mp4" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="FilePathText" Text="C:\Videos\movie.mp4" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="重新选择视频" Click="PickFile_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部底部操作栏 -->
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <TextBlock x:Name="StatusText" Text="准备就绪，请选择需要转换的视频文件。" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="RunButton" Content="导出 GIF 动图" Click="RunGif_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,10" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
