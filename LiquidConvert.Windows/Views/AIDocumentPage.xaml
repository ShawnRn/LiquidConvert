<Page
    x:Class="LiquidConvert.Windows.Views.AIDocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 Header -->
        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="AI 文档与 Markdown 提取" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="智能识别图片、PDF 及网页，转换为标准 Markdown 文本与结构化表格。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="选择文档文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- 中部内容与预览区 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <!-- 拖拽/状态与 Markdown 结果 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyZone" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="32" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽文档或图片到这里" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="支持 PDF, PNG, JPG, HTML 及 Markdown 文件。" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="选择文档/图片文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 提取 Markdown 结果视图 -->
                    <Grid x:Name="ResultZone" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#0F6CBD" />
                                <TextBlock x:Name="DocTitleText" Text="提取结果预览" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="复制 Markdown" Click="CopyMarkdown_Click" Padding="14,6" />
                                <Button Content="重新导入" Click="Reset_Click" Padding="14,6" />
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="MarkdownResultBox" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" CornerRadius="8" Padding="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部底部操作栏 -->
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <TextBlock x:Name="StatusText" Text="准备就绪，等待导入文档。" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="SaveButton" Content="保存为 .md 文件" Click="SaveMarkdown_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,10" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
