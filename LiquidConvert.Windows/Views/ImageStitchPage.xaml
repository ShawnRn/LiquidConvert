<Page
    x:Class="LiquidConvert.Windows.Views.ImageStitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 Header -->
        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="图片长图与网格拼接" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="支持垂直拼接、水平长图及多宫格拼接，自由自定义边距、间距与圆角。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="添加图片" Click="AddFiles_Click" Padding="16,8" />
                <Button Content="清空画布" Click="ClearFiles_Click" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- 中部左右分栏：左侧设置，右侧画板预览与图层 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧控制面板 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="拼接效果布局" FontSize="16" FontWeight="SemiBold" />

                        <!-- 拼接方向 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="拼接模式" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="垂直长图" />
                                <ComboBoxItem Content="水平横幅" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 图片间距 -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="图片间距" FontSize="13" Opacity="0.7" />
                                <TextBlock x:Name="SpacingValueText" Text="12 px" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F6CBD" />
                            </Grid>
                            <Slider x:Name="SpacingSlider" Minimum="0" Maximum="60" Value="12" ValueChanged="SpacingSlider_ValueChanged" />
                        </StackPanel>

                        <!-- 画布外边距 -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="画布外边距" FontSize="13" Opacity="0.7" />
                                <TextBlock x:Name="MarginValueText" Text="16 px" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F6CBD" />
                            </Grid>
                            <Slider x:Name="MarginSlider" Minimum="0" Maximum="60" Value="16" ValueChanged="MarginSlider_ValueChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Opacity="0.5" />

                        <!-- 背景颜色 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="画布背景色" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="BgColorCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="纯白背景 (#FFFFFF)" />
                                <ComboBoxItem Content="深黑背景 (#000000)" />
                                <ComboBoxItem Content="透明背景" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 导出格式 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="导出格式" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="PNG 格式 (*.png)" />
                                <ComboBoxItem Content="JPEG 格式 (*.jpg)" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧图片列表与画板预览 -->
            <Border Grid.Column="1" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" AllowDrop="True" DragOver="FileList_DragOver" Drop="FileList_Drop">
                <Grid>
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="32" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽多张图片到这里开始拼接" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="至少添加 2 张图片，支持排列调整。" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="选择拼接图片" Click="AddFiles_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 已添加列表 -->
                    <ListView x:Name="FileListView" Visibility="Collapsed" SelectionMode="Single" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="6">
                                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="移除" Click="RemoveItem_Click" Tag="{Binding}" VerticalAlignment="Center" Padding="12,6" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部导出与状态栏 -->
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <TextBlock x:Name="StatusText" Text="当前已选 0 张图片 (至少需要 2 张)" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="ExportButton" Content="导出拼接长图" Click="ExportStitch_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,10" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
