<Page
    x:Class="LiquidConvert.Windows.Views.IconPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 Header -->
        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="全平台 App 图标转换" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="一键从高清图像生成 Windows (.ico), macOS (.icns), iOS & Android 图标资源包。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="选择原图文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- 中部左右分栏 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧设置 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="图标导出目标" FontSize="16" FontWeight="SemiBold" />

                        <!-- 目标平台 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="目标平台包" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="PlatformCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Windows 软件图标 (*.ico)" />
                                <ComboBoxItem Content="多尺寸 PNG 集合 (16-1024px)" />
                                <ComboBoxItem Content="iOS / macOS AppIcon 资源包" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Opacity="0.5" />

                        <!-- 圆角设置 -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="图标圆角半径" FontSize="13" Opacity="0.7" />
                                <TextBlock x:Name="RadiusValueText" Text="32 px" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F6CBD" />
                            </Grid>
                            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="200" Value="32" ValueChanged="RadiusSlider_ValueChanged" />
                            <TextBlock Text="导出为透明背景，圆角抗锯齿处理。" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧图片预览卡片 -->
            <Border Grid.Column="1" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid>
                    <!-- 未选择文件 -->
                    <StackPanel x:Name="EmptyZone" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="32" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽图标原图到这里" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="建议选择 512x512 或 1024x1024 像素的 1:1 正方形 PNG/JPEG。" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="选择图标原图" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 已选择文件 -->
                    <StackPanel x:Name="FileCard" Visibility="Collapsed" VerticalAlignment="Center" Spacing="20" MaxWidth="500" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="12" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="64" Background="#100F6CBD" CornerRadius="12">
                                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="FileNameText" Text="app_logo.png" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="FilePathText" Text="C:\Pictures\app_logo.png" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="重新选择图标" Click="PickFile_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部底部操作栏 -->
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <TextBlock x:Name="StatusText" Text="准备就绪，请选择图标原图。" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="RunButton" Content="生成图标资源包" Click="RunIcon_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,10" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
