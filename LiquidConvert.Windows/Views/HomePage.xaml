<Page
    x:Class="LiquidConvert.Windows.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="32" Padding="8,4,8,32">
            <!-- 顶部 Banner -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#0F6CBD" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="v2.5 Pro" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="欢迎使用 LiquidConvert" FontSize="26" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="全能高效率媒体转换处理工作台，原生高性能驱动，所有处理均在本地安全完成。" FontSize="14" Opacity="0.68" TextWrapping="Wrap" MaxWidth="640" />
                    </StackPanel>

                    <Image Grid.Column="1" Source="../Assets/StoreLogo.png" Width="80" Height="80" VerticalAlignment="Center" Margin="24,0,12,0" />
                </Grid>
            </Border>

            <!-- 快捷工具分类区 -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#0F6CBD" FontSize="16" />
                    <TextBlock Text="快捷功能入口" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <GridView x:Name="QuickToolsGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="QuickToolsGrid_ItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Height="130" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,14" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.ColumnSpan="2">
                                        <Border Width="36" Height="36" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="8">
                                            <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Tag}" FontSize="11" Opacity="0.5" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <FontIcon Grid.Row="2" Grid.Column="1" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.4" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- 本地处理隐私与性能保证 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#107C41" />
                        <TextBlock Text="100% 本地隐私防护" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="文件无须上传网络服务器，所有媒体转换与解析均在本地物理磁盘中高效进行。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#0F6CBD" />
                        <TextBlock Text="多核与硬件加速" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="充分调用 Windows API 及多核处理器性能，支持批量极速图片压缩与视频处理。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#C55A11" />
                        <TextBlock Text="无损与精细参数控制" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="提供像素级拼接、比例缩放、音频比特率、EXIF快门精确分析等专业控制。" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
