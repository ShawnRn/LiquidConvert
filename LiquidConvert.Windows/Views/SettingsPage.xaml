<Page
    x:Class="LiquidConvert.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="8,4,8,32" MaxWidth="800" HorizontalAlignment="Left">
            <!-- 顶栏 Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="偏好设置" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="管理个人资料、外观主题、默认保存路径及高级同步端点。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <!-- 1. 个人资料 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="个人资料" FontSize="16" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="56" Height="56" Background="{ThemeResource AvatarBackgroundBrush}" CornerRadius="28">
                            <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="显示名称" FontSize="13" Opacity="0.7" />
                            <TextBox x:Name="UserNameBox" PlaceholderText="输入你的显示名称" TextChanged="UserNameBox_TextChanged" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 外观主题 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观与主题" FontSize="16" FontWeight="SemiBold" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="应用外观模式" FontSize="13" Opacity="0.7" />
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随 Windows 系统" />
                            <ComboBoxItem Content="浅色模式 (Light)" />
                            <ComboBoxItem Content="深色模式 (Dark)" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 默认导出目录 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="文件与导出" FontSize="16" FontWeight="SemiBold" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="默认文件保存文件夹" FontSize="13" Opacity="0.7" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OutputFolderBox" IsReadOnly="True" PlaceholderText="未指定，每次手动选择保存位置" />
                            <Button Grid.Column="1" Content="浏览选择..." Click="BrowseOutputFolder_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Lark2Pad & Send2CMS 高级配置 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Lark2Pad &amp; Send2CMS 云端同步高级配置" FontSize="16" FontWeight="SemiBold" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Pad ID" FontSize="13" Opacity="0.7" />
                        <TextBox x:Name="PadIdBox" PlaceholderText="例如: liquid-pad-01" TextChanged="PadIdBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Send2CMS API Endpoint" FontSize="13" Opacity="0.7" />
                        <TextBox x:Name="CmsEndpointBox" PlaceholderText="例如: https://cms.0x001.net/api/v1/publish" TextChanged="CmsEndpointBox_TextChanged" />
                    </StackPanel>

                    <ToggleSwitch x:Name="AutoFormatToggle" Header="文档导入时自动清洗与排版" IsOn="True" Toggled="AutoFormatToggle_Toggled" />
                </StackPanel>
            </Border>

            <!-- 5. 关于 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
                <Grid>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="LiquidConvert for Windows" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="#100F6CBD" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="v2.5.0 Pro" Foreground="#0F6CBD" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="WinUI 3 &amp; Windows App SDK 驱动的高效率本地媒体工具箱。" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
