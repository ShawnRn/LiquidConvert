<Page
    x:Class="LiquidConvert.Windows.Views.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 Header -->
        <Grid>
            <StackPanel Spacing="6">
                <TextBlock Text="音频提取与格式转换" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="支持从视频文件中无损提取音频，以及 MP3, WAV, AAC, FLAC 音频格式互转。" FontSize="14" Opacity="0.65" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="选择媒体文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- 中部内容区 -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧设置卡片 -->
            <Border Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="音频导出配置" FontSize="16" FontWeight="SemiBold" />

                        <!-- 目标格式 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="输出音频格式" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="MP3 音频 (*.mp3)" />
                                <ComboBoxItem Content="AAC 音频 (*.aac)" />
                                <ComboBoxItem Content="WAV 无损音频 (*.wav)" />
                                <ComboBoxItem Content="FLAC 无损音频 (*.flac)" />
                                <ComboBoxItem Content="M4A 音频 (*.m4a)" />
                            </ComboBox>
                        </StackPanel>

                        <!-- 比特率 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="音频比特率 (Bitrate)" FontSize="13" Opacity="0.7" />
                            <ComboBox x:Name="BitrateCombo" HorizontalAlignment="Stretch" SelectedIndex="2">
                                <ComboBoxItem Content="128 kbps (标准质量)" />
                                <ComboBoxItem Content="192 kbps (高质量)" />
                                <ComboBoxItem Content="256 kbps (极高画质)" />
                                <ComboBoxItem Content="320 kbps (最高品质)" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Opacity="0.5" />

                        <!-- 剪辑范围 -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="音频截取范围 (秒)" FontSize="13" Opacity="0.7" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="StartSecBox" Header="开始时间 (s)" Value="0" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                <NumberBox Grid.Column="1" x:Name="EndSecBox" Header="结束时间 (s)" Value="0" Minimum="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Text="如果结束时间设为 0，则默认截取至文件结尾。" FontSize="11" Opacity="0.5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧文件选择与状态面板 -->
            <Border Grid.Column="1" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid>
                    <!-- 未选择文件 -->
                    <StackPanel x:Name="EmptyZone" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <Border Width="64" Height="64" Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="32" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="拖拽音频或视频文件到这里" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="支持 MP4, MOV, MKV, MP3, WAV, AAC, FLAC 等常见媒体格式。" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Content="选择媒体文件" Click="PickFile_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 已选择文件卡片 -->
                    <StackPanel x:Name="FileCard" Visibility="Collapsed" VerticalAlignment="Center" Spacing="20" MaxWidth="500" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource WorkspaceIconBackgroundBrush}" CornerRadius="12" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" Background="#100F6CBD" CornerRadius="10">
                                    <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="FileNameText" Text="sample_video.mp4" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="FilePathText" Text="C:\Users\Videos\sample_video.mp4" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button Content="重新选择其他文件" Click="PickFile_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部转换操作栏 -->
        <Border Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <TextBlock x:Name="StatusText" Text="准备就绪，请选择媒体文件。" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="RunButton" Content="开始提取/转换音频" Click="RunConvert_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="28,10" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Page>
