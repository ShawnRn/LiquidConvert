<Window x:Class="LiquidConvert.Windows.LarkLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="登录 Etherpad">
    <Grid RowSpacing="12" Padding="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="登录公司 Etherpad" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="完成网页登录后，点击“保存会话”。" Opacity="0.62" /></StackPanel>
        <WebView2 x:Name="Browser" Grid.Row="1" Margin="0,12,0,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="关闭" Click="Close_Click" /><Button Content="保存会话" Click="Save_Click" /></StackPanel>
    </Grid>
</Window>
